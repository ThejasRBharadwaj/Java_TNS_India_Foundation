{
  "info": {
    "name": "Food Delivery System - User Module",
    "description": "End-to-end Postman requests for the customer module. Run in order; the collection saves userId, foodItemId and orderId from responses.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key":"baseUrl","value":"http://localhost:8080"},
    {"key":"userId","value":"1"},
    {"key":"foodItemId","value":"1"},
    {"key":"orderId","value":"1"}
  ],
  "item": [
    {"name":"1. Register customer","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Customer created', function () { pm.response.to.have.status(201); });","if (pm.response.code === 201) { pm.collectionVariables.set('userId', pm.response.json().userId); }"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"username\": \"Test Customer\",\n  \"contactNo\": \"9876543210\",\n  \"password\": \"testpass123\"\n}"},"url":"{{baseUrl}}/api/users/register"}},
    {"name":"2. Login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"contactNo\": \"9876543210\",\n  \"password\": \"testpass123\"\n}"},"url":"{{baseUrl}}/api/users/login"}},
    {"name":"3. View customer profile","request":{"method":"GET","url":"{{baseUrl}}/api/users/{{userId}}"}},
    {"name":"4. List food items","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Food list returned', function () { pm.response.to.have.status(200); });","if (pm.response.code === 200 && pm.response.json().length > 0) { pm.collectionVariables.set('foodItemId', pm.response.json()[0].id); }"]}}],"request":{"method":"GET","url":"{{baseUrl}}/api/food-items"}},
    {"name":"5. Search food by name","request":{"method":"GET","url":"{{baseUrl}}/api/food-items?search=pizza"}},
    {"name":"6. Add item to cart","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"foodItemId\": {{foodItemId}},\n  \"quantity\": 2\n}"},"url":"{{baseUrl}}/api/users/{{userId}}/cart/items"}},
    {"name":"7. View cart and total","request":{"method":"GET","url":"{{baseUrl}}/api/users/{{userId}}/cart"}},
    {"name":"8. Update cart quantity","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"quantity\": 3\n}"},"url":"{{baseUrl}}/api/users/{{userId}}/cart/items/{{foodItemId}}"}},
    {"name":"9. Place order","event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Order created', function () { pm.response.to.have.status(201); });","if (pm.response.code === 201) { pm.collectionVariables.set('orderId', pm.response.json().orderId); }"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"deliveryAddress\": \"12 Example Road, Mysuru, Karnataka\"\n}"},"url":"{{baseUrl}}/api/users/{{userId}}/orders"}},
    {"name":"10. View order history","request":{"method":"GET","url":"{{baseUrl}}/api/users/{{userId}}/orders"}},
    {"name":"11. View specific order","request":{"method":"GET","url":"{{baseUrl}}/api/users/{{userId}}/orders/{{orderId}}"}},
    {"name":"12. Cancel pending order (optional; run once)","request":{"method":"PATCH","url":"{{baseUrl}}/api/users/{{userId}}/orders/{{orderId}}/cancel"}},
    {"name":"13. Remove item from cart (optional)","request":{"method":"DELETE","url":"{{baseUrl}}/api/users/{{userId}}/cart/items/{{foodItemId}}"}},
    {"name":"14. Logout acknowledgement","request":{"method":"POST","url":"{{baseUrl}}/api/users/logout"}},
    {"name":"15. Add food item (development helper)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"Idli Vada\",\n  \"price\": 65\n}"},"url":"{{baseUrl}}/api/dev/food-items"}}
  ]
}
